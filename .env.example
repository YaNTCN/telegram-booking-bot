# Токен от @BotFather
BOT_TOKEN=
# Куда слать уведомления о записях: ваш Telegram ID или ID группы
ADMIN_CHAT_ID=
TIMEZONE=Europe/Moscow

# Оплата: токен провайдера из @BotFather (Payments). Пусто = только «оплата на месте»
PAYMENT_TOKEN=
# Возврат денег при отмене оплаченной записи: shopId и секретный ключ из кабинета ЮKassa
# (Интеграция → Ключи API). Пусто = возвращать вручную, бот подскажет админу номер платежа
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Сколько процентов вернуть, если клиент отменил сам (салон отменяет: всегда 100)
REFUND_PERCENT=100

# Google Таблица: путь к JSON-ключу сервисного аккаунта и ID таблицы из её адреса. Пусто = без таблицы
GOOGLE_CREDENTIALS=
SPREADSHEET_ID=

# Демо: через сколько часов удалять записи (0 = не удалять)
DEMO_TTL_HOURS=24
